{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "types.js",
    "utils.js",
    "data.js",
    "timers.js",
    "analytics.js",
    "render.js",
    "events.js",
    "app.js",
    "service-worker.js",
    "scripts/**/*.js",
    "tests/**/*.mjs",
    "eslint.config.js",
    "vitest.config.js"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
